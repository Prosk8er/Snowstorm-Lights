{
	"name": "prosk8er/snowstormlights",
	"type": "phpbb-extension",
	"description": "Adds a Snowstorm and smashable christmas lights to your forum.",
	"homepage": "https://github.com/Prosk8er/Snowstorm-Lights",
	"version": "1.0.5",
	"time": "2025-10-09",
	"keywords": ["phpbb", "extension", "snowstorm", "lights"],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Tyler",
			"email": "prosk8er@gotskillslounge.com",
			"homepage": "https://gotskillslounge.com",
			"role": "Lead Developer"
		},
		{
			"name": "Rich McGirr",
			"email": "rmcgirr83@rmcgirr83.org",
			"homepage": "http://rmcgirr83.org/",
			"role": "Contributor"
		}
	],
	"require": {
		"php": ">=7.2.0",
		"composer/installers": "^1.0 || ^2.0",
		"phpbb/phpbb": ">=3.3.0"
	},
	"require-dev": {
		"phing/phing": "~2.4"
	},
	"extra": {
		"display-name": "Snowstorm and Lights",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0"
		},
		"version-check": {
			"host": "www.gotskillslounge.com",
			"directory": "/version/phpbb-extensions",
			"filename": "snowstormlights.json",
			"ssl": true
		}
	}
}
